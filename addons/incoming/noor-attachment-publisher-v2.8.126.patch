  return card.matches('a[href],button,[role="button"]')?card:null;
 }
 function linkedOpenMenu(card){
  if(!card)return null;
  const triggers=[...card.querySelectorAll('[aria-expanded="true"],[aria-controls],[aria-describedby],[data-target],[data-bs-target]')].filter(visible);
  for(const trigger of triggers){
   const ids=[trigger.getAttribute('aria-controls'),trigger.getAttribute('aria-describedby'),trigger.getAttribute('data-target'),trigger.getAttribute('data-bs-target'),trigger.getAttribute('href')]
    .filter(Boolean).flatMap(v=>v.split(/\\s+/)).map(v=>v.replace(/^#/,'')).filter(v=>/^[A-Za-z][\\w:.-]*$/.test(v));
