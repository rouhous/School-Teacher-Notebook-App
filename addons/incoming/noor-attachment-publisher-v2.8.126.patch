  const preferred=candidates.filter(el=>el.matches('[data-toggle="popover"],[data-bs-toggle="popover"],[data-toggle="dropdown"],[data-bs-toggle="dropdown"],[aria-haspopup="true"],[aria-expanded]'));
  const pool=preferred.length?preferred:candidates;
  const unique=pool.filter(el=>!pool.some(parent=>parent!==el&&parent.contains(el)));
