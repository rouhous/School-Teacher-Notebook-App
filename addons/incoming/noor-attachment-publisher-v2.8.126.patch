   if(trigger.getAttribute('aria-expanded')==='true'){
    const related=[...document.querySelectorAll('.popover,.dropdown-menu,[role="menu"],[role="dialog"],[class*="course-actions"],[class*="material-actions"]')].filter(el=>visible(el)&&!el.closest('#stnNoorHub'));
    if(related.length===1)return related[0];
   }
  }
  return null;
 }"""
