<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="16dp"
    android:background="#E9F5EF" android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="دفتر المعلم • الجدول اليومي" android:textSize="18sp" android:textColor="#075D4E" android:textStyle="bold"/>
    <TextView android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="right" android:paddingTop="10dp" android:text="افتح دفتر المعلم واضغط تحديث الويدجت"
        android:textSize="15sp" android:textColor="#153E32"/>
</LinearLayout>
