<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="10dp"
    android:background="@drawable/widget_background" android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/widget_header" android:padding="12dp" android:gravity="center"
        android:text="دفتر المعلم • جدول اليوم" android:textSize="17sp" android:textColor="#FFFFFF" android:textStyle="bold"/>
    <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="right" android:padding="7dp" android:text="الجدول اليومي"
        android:textSize="12sp" android:textColor="#4B7165"/>
    <TextView android:id="@+id/widget_current" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/widget_current" android:padding="11dp" android:gravity="right"
        android:text="الحصة الحالية" android:textSize="16sp" android:textColor="#76500F" android:textStyle="bold"/>
    <TextView android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="13" android:ellipsize="end"
            android:gravity="right" android:padding="8dp" android:lineSpacingExtra="5dp"
            android:text="افتح دفتر المعلم واضغط تحديث الويدجت" android:textSize="14sp" android:textColor="#153E32"/>
</LinearLayout>